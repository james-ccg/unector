# Get this from @BotFather for @FreightPilot_bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get this from https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite for development, Postgres URL for production
DATABASE_URL=sqlite:///freight_pilot.db

# Run `python config.py` to generate this, then paste it here
FERNET_MASTER_KEY=

# Optional: if a direct connection to api.telegram.org is blocked/unstable,
# set a proxy address here (e.g. http://user:pass@host:port or socks5://host:port).
# Leave empty to connect directly.
TELEGRAM_PROXY_URL=

# Google Cloud OAuth client - create this in Google Cloud Console
# (APIs & Services > Credentials > Create Credentials > OAuth client ID > Desktop app).
# One client works for all companies; each company authorizes it separately via gmail_setup.py.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Samsara GPS monitoring tuning (not secrets - the per-company API key is
# stored encrypted in the DB via samsara_setup.py)
SAMSARA_NEARBY_MILES=5
SAMSARA_POLL_INTERVAL_SECONDS=120

# Test mode: simulate a truck driving toward pickup/delivery instead of
# calling the real Samsara API, so alert rules can be tested with no Samsara
# account and no real trucks. See services/samsara_test_mode.py. Leave false
# in production. SPEED_MPH is deliberately unrealistic by default so a test
# run finishes in minutes instead of hours.
SAMSARA_TEST_MODE=false
SAMSARA_TEST_START_MILES=60
SAMSARA_TEST_SPEED_MPH=600

# Mini App (owner/dispatcher dashboard). JWT_SECRET_KEY signs login sessions -
# set a real random value before going live (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
JWT_SECRET_KEY=

# Public HTTPS URL where the Mini App is served (an ngrok tunnel during dev,
# your real domain once deployed). Leave empty until you have one.
MINIAPP_URL=

# The React frontend's own URL (Vite dev server locally, your real domain in
# production). Used to redirect back here after the Gmail "Connect" OAuth flow.
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------
# Two-factor authentication
# ------------------------------------------------------------------
# WebAuthn (security keys / Touch ID / Windows Hello) - works with no paid
# service. RP_ID must be the bare domain (no scheme/port); ORIGIN must be
# the exact URL the frontend is served from.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Freight Pilot
WEBAUTHN_ORIGIN=http://localhost:5173

# Email OTP via plain SMTP - a Gmail "app password"
# (myaccount.google.com/apppasswords) works fine here for development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Cloudflare Turnstile (bot protection on register/login) - free, sign up
# at dash.cloudflare.com/?to=/:account/turnstile. Leave both empty to
# disable; register/login work normally without it, just unprotected.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS OTP - needs a paid provider account. Leave SMS_PROVIDER empty to
# disable; set to "twilio" plus the three Twilio values below to enable.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------
# Billing (Stripe) - get Standard keys from dashboard.stripe.com/apikeys.
# Use the TEST-mode secret key (starts sk_test_) while building/testing.
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to http://localhost:8000/api/billing/webhook`
# during local dev (it prints a whsec_... value); the Stripe Dashboard issues
# a separate one once you register the real webhook endpoint after deploying.
STRIPE_WEBHOOK_SECRET=

# Run `python stripe_setup.py` after setting STRIPE_SECRET_KEY above - it
# creates these six Prices in your Stripe account and prints the values to
# paste in below.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MAX_5X_MONTHLY=
STRIPE_PRICE_MAX_5X_YEARLY=
STRIPE_PRICE_MAX_20X_MONTHLY=
STRIPE_PRICE_MAX_20X_YEARLY=

# Only needed if your backend doesn't run on localhost:8000 - otherwise leave
# unset. Must exactly match a redirect URI Google will accept for your OAuth
# client (loopback addresses like http://localhost:PORT/... work automatically
# for "Desktop app" clients; a real domain needs a "Web application" client
# with this URI registered in Google Cloud Console).
GMAIL_OAUTH_REDIRECT_URI=

# Set to "production" on the real server - gates cookie Secure flags and
# HSTS, both of which would break plain-http localhost development.
ENVIRONMENT=development

# Turn on once deployed somewhere that actually terminates HTTPS in front
# of this app. Leave off if a reverse proxy already redirects to HTTPS.
FORCE_HTTPS=false
