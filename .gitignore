# Secrets - never commit real credentials
.env
.env.*
!.env.example

# Database - contains real company/driver data, encrypted credentials and
# password hashes. The bare *.db glob misses a dated backup like
# freight_pilot.db.bak-20260830-152711, which is the same data with a
# different suffix - one `git add -A` away from being published.
*.db
*.db.*
*.sqlite
*.sqlite3
*.sqlite3.*
*.dump
*.sql.gz
backup/
backups/

# Key material, however it is named
*.pem
*.key
*.p12
*.pfx
service-account*.json
credentials*.json
!frontend/**/credentials*.json

# Python
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/
*.egg-info/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
frontend/dist
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

test_account.py

# Fonts fetched for scripts/make_og_image.py. DM Sans is the brand face
# and is loaded from Google Fonts at runtime by frontend/src/index.css;
# these are the same files, kept out of the tree as a build input.
.ogbuild/
